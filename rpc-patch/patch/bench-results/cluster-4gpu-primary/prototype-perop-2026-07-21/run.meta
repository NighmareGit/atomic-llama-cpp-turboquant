# prototype-perop-2026-07-21 benchmark run
run_date: 2026-07-21
branch: experiment/cuda-ipc-events (prototype checkout: /tmp/rocm-prototype-f5824E/repo)
sha: adc2ac088 + per-node-telemetry-patch
patch: ggml-rpc.cpp graph_recompute per-node timing + GGML_RPC_NODE_SAMPLE_INTERVAL=2
model: Qwen3.6-35B-A3B-APEX-MTP-I-Quality.gguf
topology:
  - ROCm0: Radeon RX 7900 XTX (24560 MiB)
  - RPC0:  127.0.0.1:50051 RTX 3060 Ti (7841 MiB) Docker, patched from prototype
  - RPC1:  192.168.8.23:50054 RTX 3090 (24123 MiB) native, patched
  - RPC2:  192.168.8.23:50055 RTX 3070 (7839 MiB) native, patched
flags: --pipeline-plus --pplus-rpc-defer-barrier --pplus-rpc-get-defer --pplus-rpc-flush
kv: q8_0 / q8_0
context: 512

telemetry_flags:
  client: GGML_SCHED_TRACE=1 GGML_SCHED_PER_NODE_TIMING=1 GGML_RPC_SERVER_TELEMETRY=1
  rpc_servers: GGML_RPC_SERVER_TELEMETRY=1 GGML_RPC_NODE_SAMPLE_INTERVAL=2

note: >
  Server ran with GGML_SCHED_PER_NODE_TIMING=1 which adds ~20x overhead.
  Curl timed out at 120s but partial telemetry was collected during generation.
  Per-op data from all 3 CUDA backends collected; ROCm per-node data via sched trace.

telemetry_files:
  - server-telemetry-3090-patched.jsonl: 77,784 node_timings entries (per-node, 1 op each)
  - server-telemetry-3070-patched.jsonl: 26,376 node_timings entries
  - server-telemetry-3060ti-patched.jsonl: 32,032 node_timings entries
  - sched-trace.jsonl: 7,041 sched trace entries (includes ROCm per-split timing)
  - llama-server-stderr.log: server lifecycle + print_timing
